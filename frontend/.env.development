# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
# 鉴权联调：本机 jcyunpu-server；业务未就绪接口仍走 VITE_USE_MOCK
VITE_API_PROXY_URL = http://127.0.0.1:8080

# 业务域 Mock（人物/项目等未对接接口仍走 Mock）；分域开关见下
VITE_USE_MOCK = true

# false = 登录/注册/用户信息打真实后端；true = 鉴权也 Mock
VITE_USE_AUTH_MOCK = false

# false = 族谱 CRUD / 回收站打真实后端
VITE_USE_GENEALOGY_MOCK = false

# false = 成员邀请码 / 加入打真实后端
VITE_USE_MEMBER_MOCK = false

# false = 人物 / 字辈打真实后端
VITE_USE_PERSON_MOCK = false

# false = 亲属关系打真实后端
VITE_USE_RELATIONSHIP_MOCK = false

# false = 订阅摘要/套餐/扩容/下单/订单/额度流水打真实后端
VITE_USE_SUBSCRIPTION_MOCK = false

# false = 协作列表/邀请/接受/移除打真实后端
VITE_USE_COLLABORATOR_MOCK = false

# Delete console
VITE_DROP_CONSOLE = false
